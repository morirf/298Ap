module EbitClock(
  input clk,
  input [7:0] load,
  input sync,
  input areset,
  input triState,
  output reg [7:0] q,
  output reg [7:0] out
);

  
  always @(posedge clk or posedge areset) begin
    if (areset) begin
         q <= 0;
    end
    else if(sync) begin
      q <= load;
    end
    else begin
      q <= q+1;
    end
  end
  assign out = triState ? q : 8'bzzzzzzzz;
endmodule
